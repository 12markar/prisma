        "strong":  { "$value": { "light": "{color.primitive.neutral.500}", "dark": "{color.primitive.neutral.400}" }, "$type": "color" },
        "focus":   { "$value": { "light": "{color.primitive.accent.500}",  "dark": "{color.primitive.accent.300}" }, "$type": "color", "$description": "3:1 minimum vs adjacent surface (WCAG 1.4.11)." }
      },
      "accent": {
        "default":  { "$value": { "light": "{color.primitive.accent.600}", "dark": "{color.primitive.accent.400}" }, "$type": "color" },
