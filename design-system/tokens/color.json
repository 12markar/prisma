        "base":    { "$value": { "light": "{color.primitive.neutral.50}",  "dark": "{color.primitive.neutral.900}" }, "$type": "color", "$description": "Default page background." },
        "raised":  { "$value": { "light": "#FFFFFF",                       "dark": "{color.primitive.neutral.800}" }, "$type": "color", "$description": "Cards, modals, sheets." },
        "sunken":  { "$value": { "light": "{color.primitive.neutral.100}", "dark": "{color.primitive.neutral.950}" }, "$type": "color", "$description": "Inset wells, code blocks." },
        "overlay": { "$value": { "light": "rgba(26, 24, 20, 0.55)",        "dark": "rgba(15, 14, 11, 0.72)" },        "$type": "color", "$description": "Scrim behind modals/sheets." },
        "inverse": { "$value": { "light": "{color.primitive.neutral.900}", "dark": "{color.primitive.neutral.50}" },  "$type": "color" }
      },
      "text": {
        "primary":   { "$value": { "light": "{color.primitive.neutral.900}", "dark": "{color.primitive.neutral.50}" },  "$type": "color", "$description": "Body text. Contrast vs surface.base — light: 15.8:1 (AAA). Dark: 16.1:1 (AAA)." },
        "secondary": { "$value": { "light": "{color.primitive.neutral.700}", "dark": "{color.primitive.neutral.200}" }, "$type": "color", "$description": "Subdued copy. Contrast vs surface.base — light: 9.4:1 (AAA). Dark: 11.7:1 (AAA)." },
