        "onAccent":  { "$value": { "light": "#FFFFFF",                       "dark": "#FFFFFF" },                       "$type": "color", "$description": "Text on accent.default. Contrast 5.4:1 (AA)." },
        "onInverse": { "$value": { "light": "{color.primitive.neutral.50}",  "dark": "{color.primitive.neutral.900}" }, "$type": "color" },
        "link":      { "$value": { "light": "{color.primitive.accent.600}",  "dark": "{color.primitive.accent.300}" }, "$type": "color" }
      },
