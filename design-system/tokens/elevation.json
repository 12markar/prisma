{
  "elevation": {
    "0": {
      "$type": "shadow",
      "$value": {
        "light": [{ "color": "transparent", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" }],
        "dark":  [{ "color": "transparent", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" }]
      }
    },
    "1": {
      "$type": "shadow",
      "$description": "Resting cards. Light: soft drop. Dark: 1px border + faint glow.",
      "$value": {
        "light": [
          { "color": "rgba(26, 24, 20, 0.04)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
          { "color": "rgba(26, 24, 20, 0.06)", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }
        ],
        "dark": [
          { "color": "rgba(255, 255, 255, 0.04)", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px", "inset": true },
          { "color": "rgba(0, 0, 0, 0.4)",        "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }
        ]
      }
    },
    "2": {
      "$type": "shadow",
      "$description": "Hovered cards, dropdowns.",
      "$value": {
        "light": [
          { "color": "rgba(26, 24, 20, 0.05)", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" },
          { "color": "rgba(26, 24, 20, 0.08)", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "0px" }
        ],
        "dark": [
          { "color": "rgba(255, 255, 255, 0.05)", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "1px", "inset": true },
          { "color": "rgba(0, 0, 0, 0.5)",        "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px" }
        ]
      }
    },
    "3": {
      "$type": "shadow",
      "$description": "Popovers, menus.",
      "$value": {
        "light": [
          { "color": "rgba(26, 24, 20, 0.06)", "offsetX": "0px", "offsetY": "4px",  "blur": "8px",  "spread": "0px" },
          { "color": "rgba(26, 24, 20, 0.10)", "offsetX": "0px", "offsetY": "8px",  "blur": "16px", "spread": "-2px" }
        ],
        "dark": [
          { "color": "rgba(255, 255, 255, 0.06)", "offsetX": "0px", "offsetY": "0px", "blur": "0px",  "spread": "1px", "inset": true },
          { "color": "rgba(0, 0, 0, 0.6)",        "offsetX": "0px", "offsetY": "4px", "blur": "16px", "spread": "0px" }
        ]
      }
    },
    "4": {
      "$type": "shadow",
      "$description": "Modals, bottom sheets.",
      "$value": {
        "light": [
          { "color": "rgba(26, 24, 20, 0.08)", "offsetX": "0px", "offsetY": "8px",  "blur": "16px", "spread": "0px" },
          { "color": "rgba(26, 24, 20, 0.12)", "offsetX": "0px", "offsetY": "16px", "blur": "32px", "spread": "-4px" }
        ],
        "dark": [
          { "color": "rgba(255, 255, 255, 0.08)", "offsetX": "0px", "offsetY": "0px",  "blur": "0px",  "spread": "1px", "inset": true },
          { "color": "rgba(0, 0, 0, 0.7)",        "offsetX": "0px", "offsetY": "8px",  "blur": "32px", "spread": "0px" }
        ]
      }
    },
    "5": {
      "$type": "shadow",
      "$description": "Toasts, top-of-stack.",
      "$value": {
        "light": [
          { "color": "rgba(26, 24, 20, 0.10)", "offsetX": "0px", "offsetY": "16px", "blur": "32px", "spread": "0px" },
          { "color": "rgba(26, 24, 20, 0.14)", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-8px" }
        ],
        "dark": [
          { "color": "rgba(255, 255, 255, 0.10)", "offsetX": "0px", "offsetY": "0px",  "blur": "0px",  "spread": "1px", "inset": true },
          { "color": "rgba(198, 101, 36, 0.08)",  "offsetX": "0px", "offsetY": "0px",  "blur": "24px", "spread": "0px" },
          { "color": "rgba(0, 0, 0, 0.8)",        "offsetX": "0px", "offsetY": "16px", "blur": "48px", "spread": "0px" }
        ]
      }
    }
