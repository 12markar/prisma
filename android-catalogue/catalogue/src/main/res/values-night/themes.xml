<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night variant inherits everything from values/themes.xml; the swap
         happens via the @color/window_background_prisma reference resolving
         to values-night/colors.xml. enforceContrast off so transparent bars
         truly stay transparent in dark mode too. -->
    <style name="Theme.Prisma" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background_prisma</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
