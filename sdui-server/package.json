{
  "name": "prisma-sdui-server",
  "version": "0.1.0",
  "private": true,
  "description": "Tiny dev server that broadcasts a JSON UI document over WebSocket. Edit layout.json (or run `npm run set <sample>`) and both Prisma catalogue apps re-render in real time.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev":   "node server.js",
    "set":   "node scripts/set-layout.mjs",
    "next":  "node scripts/set-layout.mjs next",
    "list":  "node scripts/set-layout.mjs --list",
    "demo":  "node scripts/demo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chokidar": "^4.0.1",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  }
}
